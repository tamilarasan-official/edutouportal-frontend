# =============================================================================
# Edutou frontend -- environment configuration
# =============================================================================
#
# This app needs exactly ONE variable. Everything else it knows, it asks the
# API for.
#
# LOCAL:    cp .env.example .env.local
# DOKPLOY:  NEXT_PUBLIC_API_URL must be set in TWO places -- see below.
# =============================================================================


# ----------------------------------------------------------------------------
# ---------------------- PASTE INTO DOKPLOY FROM HERE ------------------------
# ----------------------------------------------------------------------------

NODE_ENV=production

# The public origin of the Edutou API. Replace with your real domain.
#   local: http://localhost:4000
NEXT_PUBLIC_API_URL=https://api.edutou.example.com

# ----------------------------------------------------------------------------
# ------------------------- END OF DOKPLOY BLOCK -----------------------------
# ----------------------------------------------------------------------------


# =============================================================================
# IMPORTANT: NEXT_PUBLIC_API_URL goes in TWO places in Dokploy
# =============================================================================
#
#   1. Build -> Build Arguments      NEXT_PUBLIC_API_URL=https://api.edutou.example.com
#   2. Environment                   NEXT_PUBLIC_API_URL=https://api.edutou.example.com
#
# Why both: Next.js substitutes NEXT_PUBLIC_* into the browser bundle at BUILD
# time, so the build argument is what every visitor's browser actually calls.
# The environment variable is what server-side rendering and the middleware use
# at runtime, inside the container.
#
# Set only the environment variable and the app will look fine on the server
# while every browser silently calls http://localhost:4000 and fails.
#
# Because the value is baked in at build time, CHANGING IT LATER REQUIRES A
# REBUILD -- a plain restart or redeploy-without-rebuild keeps the old address.
#
#
# Two values that are NOT set here
# -------------------------------
# The API's CORS_ORIGINS must list this app's origin, and its COOKIE_DOMAIN must
# cover both hostnames. Both live in the BACKEND's environment. If login
# succeeds and then immediately bounces back to /login, those two are where to
# look -- not here.

# Public URL of the learn.edutou.in landing page; used by Admin -> Learn Page
# for the "Open live page" link and photo previews. Build-time, like the API URL.
NEXT_PUBLIC_LEARN_URL=https://learn.edutou.in
